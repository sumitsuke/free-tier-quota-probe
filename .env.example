# Copy to .env and fill in for the targets you will run. NEVER commit .env.
# Safety gate: destructive scripts refuse to run unless this is exactly 'confirmed'.
# Set it ONLY after verifying: no card registered / spend cap ON / overages OFF, per provider.
BILLING_SAFE=

# --- Supabase (Free / Nano) ---
# Direct connection is IPv6-only on Free; from an IPv4 host use the Supavisor SESSION pooler (port 5432).
# Dashboard: Project Settings > Database > Connection string > "Session pooler".
# User is "postgres.<project-ref>". Host looks like aws-0-<region>.pooler.supabase.com.
SUPABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# a second Free project (2-project cap) for the control sibling:
SUPABASE_CONTROL_URL=

# --- Neon (Free) ---
# Use a single root branch (no child branches). Standard pg connection string.
NEON_URL=postgres://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
NEON_CONTROL_URL=
# API key (to shrink the restore/history window during recovery = control-plane recovery path):
NEON_API_KEY=
NEON_PROJECT_ID=

# --- Turso (Free) ---
# libSQL URL + auth token: `turso db show <db> --url` and `turso db tokens create <db>`.
TURSO_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=
TURSO_CONTROL_URL=
TURSO_CONTROL_AUTH_TOKEN=

# --- Cloudflare D1 (Free) ---
# REST fill. Token scoped Account > D1 > Edit. Get IDs from the D1 dashboard / `wrangler d1 info`.
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=
D1_CONTROL_DATABASE_ID=
